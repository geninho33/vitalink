# =============================================================================
# VitaLink — variáveis de ambiente (Docker)
# Copie para .env na pasta deploy:  cp .env.example .env
# =============================================================================

NODE_ENV=production

# --- Portas no HOST (mapeamento oficial VitaLink) ---
# DB interno 3306 → host 3308 (3306/3307 ocupadas)
VITALINK_DB_HOST_PORT=3308
# Backend interno 3333 → host 3002
VITALINK_BACKEND_HOST_PORT=3002
# Frontend Nginx 80 → host 3102
VITALINK_FRONTEND_HOST_PORT=3102

# --- MySQL ---
MYSQL_ROOT_PASSWORD=masterkey
DB_NAME=vitalink
DB_USER=vitalink
DB_PASSWORD=vitalink_secret

# --- Backend ---
BACKEND_PORT=3333
API_PREFIX=/api/v1
RUN_MIGRATIONS=true
JWT_SECRET=troque-este-segredo-em-producao-vitalink-2026
JWT_EXPIRES_IN=8h
# Origem do frontend no host
CORS_ORIGIN=http://localhost:3102

# --- Frontend (build-time) ---
# Relativo: Nginx do frontend faz proxy /api → vitalink-backend
VITE_API_URL=/api/v1

# --- Git (usado por deploy.sh) ---
GIT_REMOTE=origin
GIT_BRANCH=dev
