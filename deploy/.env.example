# =============================================================================
# VitaLink — variáveis de ambiente (Docker)
# Copie para .env na pasta deploy:  cp .env.example .env
# =============================================================================

NODE_ENV=production

# --- Portas no HOST (mapeamento oficial VitaLink) ---
# 5433 evita conflito com outro Postgres na VPS (5432)
VITALINK_DB_HOST_PORT=5433
VITALINK_BACKEND_HOST_PORT=3002
VITALINK_FRONTEND_HOST_PORT=3102
VITALINK_FRONTEND_HTTPS_HOST_PORT=3443

# --- PostgreSQL 16 ---
DB_NAME=vitalink
DB_USER=vitalink
# OBRIGATÓRIO: Gere senha forte com: openssl rand -base64 24
# NUNCA use o valor de exemplo em produção!
DB_PASSWORD=TROQUE_POR_SENHA_FORTE_GERADA
VITALINK_PG_IMAGE=postgres:16-alpine

# --- Backend ---
# Porta INTERNA do container é sempre 3333 (fixada no docker-compose).
# NÃO defina PORT=8001 aqui — isso quebra healthcheck e o proxy Nginx.
# Para expor no host, use só VITALINK_BACKEND_HOST_PORT acima.
API_PREFIX=/api/v1
RUN_MIGRATIONS=true

# --- Rate Limiting ---
# Global: requisições por IP em 15 minutos
RATE_LIMIT_GLOBAL=1000
# Login: tentativas de login por IP em 15 minutos
RATE_LIMIT_AUTH=5
# Registro/Recuperação: tentativas por IP em 1 hora
RATE_LIMIT_SENSITIVE=3

# --- Trust Proxy ---
# Número de proxies confiáveis antes da API (nginx host → nginx frontend → API = 2)
TRUST_PROXY_HOPS=2

# OBRIGATÓRIO: Gere segredo forte com: openssl rand -base64 48
# Mínimo 32 caracteres. NUNCA use o valor de exemplo!
# AVISO: Trocar este valor invalida todos os JWTs ativos (logout de todos).
JWT_SECRET=TROQUE_POR_SEGREDO_FORTE_GERADO
JWT_EXPIRES_IN=8h

# OBRIGATÓRIO em produção: liste explicitamente as origens permitidas
# Produção: https://homolog.vitalink.app.br
# Desenvolvimento: http://localhost:5173
# NUNCA use wildcard (*) em produção!
CORS_ORIGIN=https://homolog.vitalink.app.br

# --- Frontend (build-time) ---
# OBRIGATÓRIO relativo quando o site é HTTPS (homolog.vitalink.app.br):
#   VITE_API_URL=/api/v1
# NÃO use http://IP:porta — o browser bloqueia mixed content (HTTPS→HTTP).
# Após alterar, é preciso rebuild do frontend: ./deploy.sh rebuild
VITE_API_URL=/api/v1

# --- Git (usado por deploy.sh) ---
GIT_REMOTE=origin
GIT_BRANCH=dev
