# =============================================================================
# VitaLink — variáveis de ambiente (Docker)
# Copie para .env na pasta deploy:  cp .env.example .env
# =============================================================================

NODE_ENV=production

# --- Portas no HOST (mapeamento oficial VitaLink) ---
VITALINK_DB_HOST_PORT=3308
VITALINK_BACKEND_HOST_PORT=3002
# Frontend HTTP
VITALINK_FRONTEND_HOST_PORT=3102
# Frontend HTTPS (certificado autoassinado — evita alerta de senha em HTTP)
VITALINK_FRONTEND_HTTPS_HOST_PORT=3443

# --- MySQL ---
# ATENÇÃO: o healthcheck do docker-compose usa -pmasterkey.
# Se alterar esta senha, atualize também o healthcheck em docker-compose.yml.
MYSQL_ROOT_PASSWORD=masterkey
DB_NAME=vitalink
DB_USER=vitalink
DB_PASSWORD=vitalink_secret
# Imagem do banco (obrigatório série 8.0)
VITALINK_MYSQL_IMAGE=mysql:8.0

# --- Backend ---
BACKEND_PORT=3333
API_PREFIX=/api/v1
RUN_MIGRATIONS=true
JWT_SECRET=troque-este-segredo-em-producao-vitalink-2026
JWT_EXPIRES_IN=8h
# Use * para aceitar acesso por IP do servidor (ex.: http://69.x.x.x:3102)
# Ou liste origens: http://localhost:3102,http://SEU_IP:3102,https://SEU_IP:3443
CORS_ORIGIN=*

# --- Frontend (build-time) ---
VITE_API_URL=/api/v1

# --- Git (usado por deploy.sh) ---
GIT_REMOTE=origin
GIT_BRANCH=dev
