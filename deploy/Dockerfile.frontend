# syntax=docker/dockerfile:1
# VitaLink Web — build React + Nginx (HTTP + HTTPS autoassinado)
FROM node:20-alpine AS build
WORKDIR /app
COPY frontend/package.json ./
RUN npm install
COPY frontend/ ./
ARG VITE_API_URL=/api/v1
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

FROM nginx:1.27-alpine AS runner
RUN apk add --no-cache openssl \
  && mkdir -p /etc/nginx/certs \
  && openssl req -x509 -nodes -days 825 -newkey rsa:2048 \
       -keyout /etc/nginx/certs/vitalink.key \
       -out /etc/nginx/certs/vitalink.crt \
       -subj "/CN=vitalink/O=VitaLink/C=BR"

COPY deploy/proxy_api.inc /etc/nginx/proxy_api.inc
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80 443
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1/healthz || exit 1
CMD ["nginx", "-g", "daemon off;"]
